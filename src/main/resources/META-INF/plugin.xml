<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>cz.loplex.ij-git-reflog</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Git Reflog</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Adds a <b>Reflog</b> tab to the Git tool window.<br>
        The tab shows the entries of <code>git reflog</code> for the current repository, so that commits that are no
        longer reachable from any branch - the ones left behind by a reset, an amend or a rebase - stay one click away.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.GitReflogBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Persistent tabs of the Git and Commit tool windows are contributed through this extension point;
             isInCommitToolWindow=false puts the tab next to Log and Console in the Git tool window. -->
        <changesViewContent id="cz.loplex.git.reflog"
                            tabName="Reflog"
                            className="cz.loplex.reflog.ui.GitReflogContentProvider"
                            predicateClassName="cz.loplex.reflog.ui.GitReflogContentVisibilityPredicate"
                            preloaderClassName="cz.loplex.reflog.ui.GitReflogContentPreloader"
                            displayNameSupplierClassName="cz.loplex.reflog.ui.GitReflogDisplayNameSupplier"
                            isInCommitToolWindow="false"/>
    </extensions>

    <actions>
        <group id="GitReflog.Toolbar">
            <action id="GitReflog.Refresh"
                    class="cz.loplex.reflog.actions.GitReflogRefreshAction"
                    icon="AllIcons.Actions.Refresh"
                    use-shortcut-of="Refresh"/>
        </group>

        <group id="GitReflog.ContextMenu">
            <action id="GitReflog.ShowDiff"
                    class="cz.loplex.reflog.actions.GitReflogShowDiffAction"
                    icon="AllIcons.Actions.Diff"
                    use-shortcut-of="Diff.ShowDiff"/>
            <separator/>
            <action id="GitReflog.CheckoutRevision"
                    class="cz.loplex.reflog.actions.GitReflogCheckoutRevisionAction"/>
            <action id="GitReflog.NewBranch"
                    class="cz.loplex.reflog.actions.GitReflogNewBranchAction"
                    icon="AllIcons.Vcs.BranchNode"/>
            <action id="GitReflog.Reset"
                    class="cz.loplex.reflog.actions.GitReflogResetAction"
                    icon="AllIcons.Vcs.Merge"/>
            <separator/>
            <!-- Both platform actions work off the revision numbers the tab publishes into the data context. -->
            <reference ref="Vcs.Log.SelectInLog"/>
            <reference ref="Vcs.CopyRevisionNumberAction"/>
        </group>
    </actions>

</idea-plugin>
